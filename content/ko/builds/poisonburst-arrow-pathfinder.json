    {
      "type": "overview",
      "id": "budget-variants",
      "title": "예산 변형",
      "order": 130,
      "toc": true,
      "visible": true,
      "paragraphs": [
        "리그 스타터는 실버터응과 희귀 활을 사용합니다. 중간 예산은 퀴버 업그레이드와 독성 성장 서포트를 추가합니다. 최상위 치명타 빌드는 별개의 상한일 뿐, 리그 스타터의 필수 요건이 아닙니다."
      ],
      "bullets": []
