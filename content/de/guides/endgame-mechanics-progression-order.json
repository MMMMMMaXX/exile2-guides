    {
      "id": "progression-order",
      "order": 5,
      "title": "Vorgeschlagene Progression-Reihenfolge",
      "type": "progression-steps",
      "visible": true,
      "toc": true,
      "steps": [
        {
          "label": "Atlas stabilisieren",
          "body": [
            "Binde Festung und frühe Atlas-Punkte; das ist das Rückgrat, auf dem alles andere aufbaut."
          ]
        },
        {
          "label": "Eine kartengesteuerte Kette wählen",
          "body": [
            "Wähle Breach oder Abyss bei Clear-Tempo, Ritual bei ausgeglichenem Spiel; spiele sie bis zum Pinnacle, um die Schleife zu lernen."
          ]
        },
        {
          "label": "Eine Pinnacle-Prüfung hinzufügen",
          "body": [
            "Sobald ausgerüstet, füge Trial of Chaos oder Sekhemas für Schicksale, Relikte und Ascendancy-Fortschritt hinzu."
          ]
        },
        {
          "label": "Zu Delirium / Vaal verzweigen",
          "body": [
            "Füge Delirium für Destilliertes und Simulacrum hinzu, Vaal-Tempel für seine langsame Bau-Route, je nach Punkten."
          ]
        },
        {
          "label": "Den Rest füllen",
          "body": [
            "Sobald die Punkte reichlich vorhanden sind, spiele die verbleibenden Ketten für ihre einzigartigen Belohnungen und Boss-Freischaltungen."
          ]
        }
      ]
    },
