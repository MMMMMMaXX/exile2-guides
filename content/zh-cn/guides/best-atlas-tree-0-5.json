      "toc": true,
      "items": [
        {
          "question": "要立即冲物品数量吗？",
          "answer": ["不要。只有 Waystone 续航与生存稳定后，数量才有意义。"]
        },
        {
          "question": "如何选 Atlas Master？",
          "answer": ["选择能强化你最稳定、也愿意长期刷的单一机制的 Master。"]
        }
      ]
