    {
      "id": "sustain-diagnostic",
      "order": 6,
      "title": "为什么我的地图在减少？",
      "type": "diagnostic",
      "visible": true,
      "toc": true,
      "intro": "选择你遇到的现象。工具指向缺失的杠杆。",
      "controls": [
        {
          "id": "symptom",
          "label": "发生了什么？",
          "options": [
            {
              "label": "不再掉落界石",
              "value": "no-drop"
            },
            {
              "label": "高阶石消失",
              "value": "starve"
            },
            {
              "label": "地图太难",
              "value": "hard"
            },
            {
              "label": "首领不掉好东西",
              "value": "boss"
            }
          ]
        }
      ],
      "rules": [
        {
          "title": "你在跳阶或未按顺序刷",
          "when": {
            "symptom": "no-drop"
          },
          "steps": [
            "在你实际拥有界石的阶数刷地图；不要越阶。",
            "每张完成的地图掉落同级或更高阶界石——持续刷会回补池子。",
            "用三合一重铸从剩余石重建高一阶。"
          ]
        },
        {
          "title": "你烧掉了唯一的高阶石",
          "when": {
            "symptom": "starve"
          },
          "steps": [
            "降一阶刷，并用续航节点与重铸重建。",
            "在异界树上点恒常十字路口 / 幸运之路 / 高速大道。",
            "停止在刷不过的地图里用高阶石。"
          ]
        },
        {
          "title": "推阶前先提升装备",
          "when": {
            "symptom": "hard"
          },
          "steps": [
            "先堆满抗性与生命/防御；死掉的角色不掉地图。",
            "用希尔达首领被动与塔碑文让地图更简单，而非更难。"
          ]
        },
        {
          "title": "点希尔达被动并用法塔",
          "when": {
            "symptom": "boss"
          },
          "steps": [
            "首张地图首领后与希尔达对话，解锁首领被动节点。",
            "在你farm 区域上方的塔中镶嵌先驱碑文，提升首领奖励。"
          ]
        }
      ],
      "defaultResult": {
        "title": "通用续航恢复",
        "steps": [
          "按阶刷地图，点续航异界节点，并占领带碑文的塔。",
          "将三枚低阶界石重铸为一枚高一阶，而非卖给商人。",
          "若卡住，观看所引用的终局推进指南获取完整可视路线。"
        ]
      }
    },
