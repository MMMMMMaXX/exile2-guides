      "id": "gear-diagnostic",
      "order": 6,
      "title": "我的装备卡住了",
      "type": "diagnostic",
      "visible": true,
      "toc": true,
      "intro": "选择拖你后腿的因素。工具会给出修复方法。",
      "controls": [
        {
          "id": "issue",
          "label": "缺口是什么？",
          "options": [
            { "label": "伤害太低", "value": "damage" },
            { "label": "抗性没封顶", "value": "resist" },
            { "label": "生命不足", "value": "life" },
            { "label": "属性短缺", "value": "attr" }
          ]
        }
      ],
      "rules": [
        {
          "title": "先升级武器与连接",
          "when": { "issue": "damage" },
          "steps": [
            "更高的基础 DPS 武器胜过多数被动点——升级它。",
            "完成你的 6 连并提升主技能石等级。",
            "若通货允许，在有好标签的稀有底子上用点金 / 混沌。"
          ]
        },
        {
          "title": "用制作台补缺失抗性",
          "when": { "issue": "resist" },
          "steps": [
            "使用制作台添加你缺失的特定抗性。",
            "优先在进地图前让三种元素都达到 75%。",
            "把抗性移到装备上，让被动点可以去堆伤害。"
          ]
        },
        {
          "title": "用制作台或刷更多生命",
          "when": { "issue": "life" },
          "steps": [
            "在你最大的护甲槽位上制作最大生命。",
            "优先选择带有生命词缀或隐词的装备。",
            "偏薄的生命池是地图中被秒的主要成因。"
          ]
        },
        {
          "title": "制作你需要的属性",
          "when": { "issue": "attr" },
          "steps": [
            "在戒指或项链上用制作台添加缺失的属性。",
            "或者把一个被动点重洗到属性节点上。",
            "满足属性需求能解锁更高等级的技能石与装备。"
          ]
        }
      ],
      "defaultResult": {
        "title": "通用装备方案",
        "steps": [
          "用制作台封顶抗性、增长生命、保持高武器 DPS，把顶级通货留给终局稀有物品。",
          "每升几级小幅升级，而不是等完美掉落。",
          "可观看文末引用的装备与制作指南获取完整视觉走查。"
        ]
      }
