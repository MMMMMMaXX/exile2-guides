        {
          "id": "party",
          "label": "组队",
          "paragraphs": [
            "组队时祭坛波次被共享、更易清，但贡礼与恩典按实例的房主规则分配。",
            "进图前确认谁是房主、奖励如何分配，因为进度与掉落可能不同于单人。"
          ],
          "bullets": [
            "波次更易清",
            "贡礼与恩典按房主分配",
            "先约定房主与掉落"
          ],
          "steps": []
        }
      ]
