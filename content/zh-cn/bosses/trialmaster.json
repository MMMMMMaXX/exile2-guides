        {
          "label": "高 AoE 清理速度",
          "checks": [
            "确认能在 15 秒内清理 6 个构装体。"
          ],
          "why": "波次必须快速清理；每个存活构装体增加威胁持续时间。",
          "fix": "携带最高 AoE 技能组合；单体输出是次要的。"
        },
        {
          "label": "混沌和火焰抗性 75%",
          "checks": [
            "确认混沌和火焰抗性都满。"
          ],
          "why": "毒云造成混沌伤害；火焰喷射造成火焰伤害。两者都是不可避免的威胁。",
          "fix": "使用黄玉和红宝石圣瓶；护甲工艺混沌后缀。"
        },
        {
          "label": "高移动速度（40%+）",
          "checks": [
            "确认 40% 以上移动速度。"
          ],
          "why": "旋转刀刃需要持续重新定位；慢速角色会被逼入角落。",
          "fix": "移速靴、顺风辅助或冲刺技能。"
        },
        {
          "label": "脆弱窗口持续 DPS",
          "checks": [
            "确认能在 8 秒窗口内造成 200 万以上伤害。"
          ],
          "why": "试炼主宰只在波次间脆弱 8 秒。最大化此窗口。",
          "fix": "将爆发冷却保留给脆弱窗口；不要浪费在构装体上。"
        }
