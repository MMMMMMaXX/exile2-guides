      "type": "troubleshooting",
      "problems": [
        {
          "symptom": "威胁淹没前来不及清理构装体",
          "checks": [
            "确认 AoE 能在 15 秒内清 6 个构装体。",
            "检查是否在追击构装体进入威胁区而非风筝到中心。"
          ],
          "directAnswer": [
            "用环形路径将所有构装体拉到竞技场中心。你的 AoE 应同时命中所有。绝不追击单个构装体到边缘。"
          ],
          "relatedContentIds": []
        },
        {
          "symptom": "第二波和第三波精英打太久",
          "checks": [
            "确认先杀非精英以移除激怒增益。",
            "检查脆弱窗口的单体 DPS。"
          ],
          "directAnswer": [
            "先杀所有非精英构装体。没有其他构装体存活时精英失去激怒光环，多受 30% 伤害。然后用爆发冷却集中精英。"
          ],
          "relatedContentIds": []
        }
      ]
