    {
      "id": "quick-answer",
      "type": "quick-answer",
      "title": "先记住这几条",
      "toc": true,
      "visible": true,
      "order": 0,
      "callout": "Diamora, Song of Death 是位于 Singing Caverns 的第四章岛屿 Boss。石化凝视是核心机制——你必须把镜头从她的脸和镜面上转开。",
      "calloutDetail": [
        "自 0.5.2 起只有一次石化阶段，而非多次——旧的多阶段片段属于旧版。",
        "镜面会反射她的脸；看她的脸或亮起的镜面都会叠加石化。",
        "若她下潜后不再出现，很可能是软锁——在检查点重生重置。"
      ],
      "answers": [
        {
          "label": "核心机制",
          "text": "转开视线避开凝视+镜面"
        },
        {
          "label": "补丁",
          "text": "0.5.2 = 单次石化阶段"
        },
        {
          "label": "水系危险",
          "text": "Geysers + Drowning Orbs"
        },
        {
          "label": "若消失",
          "text": "重生重置下潜"
        }
      ],
