        {
          "label": "开荒 → 实用",
          "body": [
            "通用猛击；在追独特前先满抗性与生命。"
          ]
        },
        {
          "label": "实用 → 终局",
          "body": [
            "获取三件核心独特，再堆叠最大法力并加猛击辅助。"
          ]
        },
        {
          "label": "终局 → 奢华",
          "body": [
            "在 T15 轻松后再追完美法力词缀、暴击装备与珠宝。"
          ]
        }
      ]
