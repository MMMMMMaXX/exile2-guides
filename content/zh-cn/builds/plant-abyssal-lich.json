          "skills": [
            {
              "displayName": "Entangle",
              "skillId": "entangle",
              "role": "从 1 级起的主清图技能；定身并伤害怪群",
              "supportSkillIds": [
                "physical-mentor",
                "arcane-tempo",
                "concentrated-effect"
              ],
              "notes": ["从 1 级可用，这正是开荒顺滑的原因。"],
              "whyUse": ["Entangle 是你顺滑开荒的清图技能，并延续到终局核心。"]
            },
            {
              "displayName": "Thrashing Vines",
              "skillId": "thrashing-vines",
