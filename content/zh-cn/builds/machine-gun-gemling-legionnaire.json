    {
      "type": "question-answer",
      "id": "question-answer",
      "title": "问答",
      "order": 840,
      "toc": true,
      "visible": true,
      "items": [
        {
          "question": "为何 Armour Piercing Rounds 适合清图？",
          "answer": [
            "一旦品质与破甲对齐，它撕裂护甲并 Chain 穿透怪群；清图又快又广。"
          ],
          "bullets": []
        },
        {
          "question": "Advanced Thaumaturgy 做什么？",
          "answer": [
            "它放大宝石品质的效果，这正是品质堆叠成为核心缩放路径的原因。"
          ],
          "bullets": []
        },
        {
          "question": "一键清图等于一键 Boss 吗？",
          "answer": [
            "不。清图用 Armour Piercing Rounds；Boss 用组 2 的 High Velocity Rounds，配合确认破甲的循环。"
          ],
          "bullets": []
        },
        {
          "question": "要在第一把弩上造装吗？",
          "answer": [
            "不。只在你会保留的终局底材上造装；过渡武器不值得投入通货。"
          ],
          "bullets": []
        }
      ]
    },
    {
      "type": "troubleshooting",
      "id": "troubleshooting",
      "title": "故障排查",
      "order": 860,
      "toc": true,
      "visible": true,
      "problems": [
        {
          "symptom": "低伤害",
          "checks": [
            "先确认破甲已施加；缺破甲解释了多数「弱」的反馈。再查品质与辅助颜色。"
          ]
        },
        {
          "symptom": "在线率不足 / 换弹慌",
          "checks": [
            "在移动窗口中换弹；Emergency Reload 留到被抓时。在戒指/箭袋加换弹速度。"
          ]
        }
      ]
    },
    {
      "type": "build-planner",
      "id": "build-planner",
      "title": "配装器",
      "order": 880,
      "toc": true,
      "visible": true,
