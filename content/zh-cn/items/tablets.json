  "sections": [
    {
      "id": "quick-answer",
      "order": 10,
      "title": "快速结论",
      "toc": true,
      "visible": true,
      "type": "quick-answer",
      "callout": "在穿越前把先驱徽印与界石一起镶嵌。每个徽印把它的内嵌内容（裂隙、迷雾、远征、仪式、辐照或监管者）加到该节点周围的地图。徽印按每次界石使用消耗一次，所以失败的地图仍然消耗那次使用。",
      "calloutDetail": [
        "槽位数量由界石词缀数决定：0-2 词缀=1 槽，3-5=2，6+=3。",
        "徽印只有魔法稀有度（1 前缀 + 1 后缀），不能升为稀有。"
      ],
      "answers": [
        {
          "label": "先规划",
          "text": [
            "选你想farm的玩法，再让高塔重叠使徽印叠加。"
          ]
        },
        {
          "label": "SSF 推进",
          "text": [
            "辐照/通用先驱徽印提升区域等级与奖励，风险更低。"
          ]
        },
        {
          "label": "避免",
          "text": [
            "把徽印镶在无法完成的地图上——那次使用被浪费。"
          ]
        }
      ],
