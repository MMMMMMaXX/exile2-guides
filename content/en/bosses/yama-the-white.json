      "order": 1,
      "items": [
        {
          "question": "Which quest step is Yama in?",
          "answer": [
            "He appears in the Halls of the Dead during the Act 4 route; defeat him to unlock Yama's Test."
          ]
        },
        {
          "question": "How do I unlock Yama's Test?",
          "answer": [
            "Defeat Yama in the Halls of the Dead; the encounter opens Yama's Test."
          ]
        },
        {
          "question": "What is the safe position?",
          "answer": [
            "The final safe position that appears during the apparition phase; pillars provide verified line-of-sight cover."
          ]
        },
        {
          "question": "Does hiding behind a pillar always work?",
          "answer": [
            "On the current patch it is a stable tactic when the safe spot is the pillar LoS; verify per patch, do not assume it blindly."
          ]
        },
        {
          "question": "Is the big explosion a one-shot?",
          "answer": [
            "No. Do not use unsourced absolute claims; the explosion is telegraphed and dodgeable on the current patch."
          ]
        }
      ]
