    {
      "id": "quick-answer",
      "type": "quick-answer",
      "title": "Remember These First",
      "toc": true,
      "visible": true,
      "order": 0,
      "callout": "Yama, the White is an Act 4 optional boss in the Halls of the Dead. Beating him does NOT directly grant the +2 Weapon Set Passive Points — that comes later through the Trial of the Ancestors chain.",
      "calloutDetail": [
        "During the apparition phase, find the final safe position; pillars give verified line-of-sight cover.",
        "The Silver Coin drops from Yama and starts the Trial of the Ancestors chain.",
        "The +2 Weapon Set Passive Points are earned after the Trial, via the Tattoo of Hinekora — not from the kill alone."
      ],
      "answers": [
        {
          "label": "Kill = points?",
          "text": "No, Trial chain grants them"
        },
        {
          "label": "Safe spot",
          "text": "Final position / pillar LoS"
        },
