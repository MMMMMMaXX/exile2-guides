    {
      "id": "positioning-guide",
      "type": "overview",
      "title": "Positioning Guide",
      "toc": true,
      "visible": true,
      "order": 7,
      "paragraphs": [
        "Azmadi rewards patient positioning. Keep at mid range so the Dash and radial attacks have clear dodge lines, and use the time-stop to set up outside the radius.",
        "Melee still triggers Dash, but the 0.5.2 change means it is no longer the double-hit threat older guides describe — respect the lunge, do not over-fear it."
      ],
      "bullets": [
        "Mid range keeps dodge lines clear.",
        "Use time-stop to move outside the radial.",
        "Melee: respect the lunge, no longer a double-hit."
      ]
    },
