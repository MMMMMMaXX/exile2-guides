    {
      "id": "faq",
      "type": "faq",
      "title": "Top search questions: entry, time-stop, Dash",
      "toc": true,
      "visible": true,
      "order": 1,
      "items": [
        {
          "question": "Which Interlude and how do I reach him?",
          "answer": [
            "Interlude 2. Progress the Interlude questline to Qimah Reservoir to trigger the fight."
          ]
        },
        {
          "question": "What does Zarokh's time stop do?",
          "answer": [
            "Zarokh appears and stops time, layering telegraphed hazards. Use the window to reposition, not to panic-dodge."
          ]
        },
        {
          "question": "Did the Dash get nerfed?",
          "answer": [
            "Yes — 0.5.2 changed the Dash so it no longer double-hits and is used differently against melee. Old one-shot clips are legacy."
          ]
        },
        {
          "question": "Is anything a guaranteed one-shot?",
          "answer": [
            "No. Red-flash attacks are dangerous but telegraphed; treat them as high-danger commitment windows, not fixed one-shots."
          ]
        }
      ]
