    {
      "id": "faq",
      "type": "faq",
      "title": "Top search questions: Spirit, buff, items",
      "toc": true,
      "visible": true,
      "order": 1,
      "items": [
        {
          "question": "Is Ignagduk optional?",
          "answer": [
            "Yes — she is an Act 3 optional boss, but the permanent +30 Spirit makes her a high-priority target."
          ]
        },
        {
          "question": "Where does +30 Spirit come from?",
          "answer": [
            "From Gemrot Skull, a drop you must right-click to consume. It is not auto-granted by the kill or by talking to Servi."
          ]
        },
        {
          "question": "What is the Ghastly Spear for?",
          "answer": [
            "A separate drop handed to Servi to complete Tribal Vengeance / claim the quest reward. It is not the Spirit item."
          ]
        },
        {
          "question": "Why do players think she gives passive points?",
          "answer": [
            "Confusion with other bosses; Ignagduk grants Spirit via the Skull, not passive skill points."
          ]
        }
      ]
    },
