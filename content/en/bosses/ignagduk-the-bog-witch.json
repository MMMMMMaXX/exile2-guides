    {
      "id": "quick-answer",
      "type": "quick-answer",
      "title": "Remember These First",
      "toc": true,
      "visible": true,
      "order": 0,
      "callout": "Ignagduk, the Bog Witch is an Act 3 optional boss worth killing for the permanent +30 Maximum Spirit from the Gemrot Skull — but the Skull must be USED, not just picked up.",
      "calloutDetail": [
        "The +30 Spirit comes from Gemrot Skull; right-click it to consume and gain the permanent boost.",
        "Her Ghastly Spear is a separate item handed to Servi for a quest reward — it is not the Spirit source.",
        "The pre-fight ritual grants a Fire Resistance buff; grab the five Effigies first."
      ],
      "answers": [
        {
          "label": "Why fight",
          "text": "Permanent +30 Spirit"
        },
        {
          "label": "How to get it",
          "text": "Use Gemrot Skull (right-click)"
        },
        {
          "label": "Other item",
          "text": "Ghastly Spear -> Servi"
        },
        {
          "label": "If reward missing",
          "text": "Check Skull use + map icon"
        }
      ],
