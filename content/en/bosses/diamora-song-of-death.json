    {
      "id": "quick-answer",
      "type": "quick-answer",
      "title": "Remember These First",
      "toc": true,
      "visible": true,
      "order": 0,
      "callout": "Diamora, Song of Death is an Act 4 island boss in the Singing Caverns. The petrification gaze is the defining mechanic — you must turn your camera away from her face and the mirrors.",
      "calloutDetail": [
        "Since 0.5.2 there is only ONE petrification phase, not multiple — old multi-phase clips are legacy.",
        "Mirrors reflect her face; looking at either her or a lit mirror stacks petrification.",
        "If she dives and never returns, it is likely a softlock — respawn at checkpoint to reset."
      ],
      "answers": [
        {
          "label": "Key mechanic",
          "text": "Turn away from gaze + mirrors"
        },
        {
          "label": "Patch note",
          "text": "0.5.2 = single petrify phase"
        },
        {
          "label": "Water hazard",
          "text": "Geysers + Drowning Orbs"
        },
        {
          "label": "If gone",
          "text": "Respawn to reset the dive"
        }
      ],
      "links": [
        {
