    {
      "id": "faq",
      "type": "faq",
      "title": "Top search questions: petrification, route, mirrors",
      "toc": true,
      "visible": true,
      "order": 1,
      "items": [
        {
          "question": "Is Diamora required or optional?",
          "answer": [
            "She is an Act 4 island boss tied to the current league route; treat her as a high-value optional with a Shoreline Hideout unlock."
          ]
        },
        {
          "question": "Why do I get petrified?",
          "answer": [
            "You stacked petrification by looking at her face or a lit mirror. Turn your camera away during the gaze phase."
          ]
        },
        {
          "question": "Why did the petrify phase change?",
          "answer": [
            "0.5.2 reduced it to a single petrification phase. Multi-phase petrify clips are legacy footage."
          ]
        },
        {
          "question": "She dived and never came back?",
          "answer": [
            "That is a known softlock case. Respawn at checkpoint to reset the encounter."
          ]
        }
      ]
    },
