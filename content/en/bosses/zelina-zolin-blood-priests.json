    {
      "id": "faq",
      "type": "faq",
      "title": "Top search questions: healing, order, zero HP",
      "toc": true,
      "visible": true,
      "order": 1,
      "items": [
        {
          "question": "Why does one keep healing?",
          "answer": [
            "They share a blood siphon link: one priest drains life from the other, refilling the bar. It is a mechanic, not a bug."
          ]
        },
        {
          "question": "Should I kill Zelina or Zolin first?",
          "answer": [
            "Build-specific. Kill the healer if you out-damage the siphon; kill the damage dealer if you cannot keep up with healing."
          ]
        },
        {
          "question": "Zero HP but not dead?",
          "answer": [
            "That is the siphon refilling the bar — switch targets to break the link and confirm on the current patch."
          ]
        },
        {
          "question": "How do I stop the healing?",
          "answer": [
            "Switch targets so the siphon source is under pressure; burst the link breaker when both are low."
          ]
        }
      ]
    },
