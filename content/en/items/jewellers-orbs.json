      "title": "FAQ",
      "toc": true,
      "visible": true,
      "type": "faq",
      "items": [
        {
          "question": "Can I skip tiers?",
          "answer": [
            "Yes, use the tier that matches the count you want; you do not need each lower tier first."
          ]
        },
        {
          "question": "Can a low tier reduce a high count?",
          "answer": [
            "No. The orb sets the count; a lower tier will not downgrade it."
          ]
        },
        {
          "question": "Should I use Perfect in the campaign?",
          "answer": [
            "Usually no; wait until your main skill and supports are final."
          ]
        }
