      "id": "vaal-vs-architect",
      "order": 30,
      "title": "Vaal Orb vs Architect's Orb",
      "toc": true,
      "visible": true,
      "type": "effect",
      "paragraphs": [
        "Vaal Orb corrupts an item that is not yet corrupted, applying a corruption outcome and locking further normal currency use.",
        "Architect's Orb is the follow-up step: it acts only on an already-corrupted item and can push that corruption further, with a chance to improve or destroy the item. The two are sequential, not interchangeable."
      ],
      "bullets": [
        "Vaal Orb: uncorrupted -> corrupted.",
        "Architect's Orb: corrupted -> modified or destroyed."
      ]
    },
