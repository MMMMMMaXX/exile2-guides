      "id": "quick-answer",
      "order": 10,
      "title": "Quick answer",
      "toc": true,
      "visible": true,
      "type": "quick-answer",
      "callout": "Architect's Orb only works on items that are already corrupted. It can modify the item or destroy it; the exact odds are not officially published, so treat the outcome as uncertain.",
      "calloutDetail": [
        "It is not a replacement for Vaal Orb; Vaal Orb corrupts an uncorrupted item first.",
        "Only gamble an item you can afford to lose."
      ],
      "answers": [
        {
          "label": "Use it",
          "text": [
            "Use it on a corrupted item where a possible improvement is worth the destroy risk."
          ]
        },
        {
          "label": "Hold it",
          "text": [
            "Hold it unless you have a corrupted item you are willing to lose."
          ]
        },
        {
          "label": "Do not use",
          "text": [
            "Do not use on a corrupted item you cannot replace."
          ]
