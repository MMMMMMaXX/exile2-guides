{
  "name": "exile2-guides",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-og-images.mjs && react-router build",
    "check:comments": "tsx scripts/check-comments.ts",
    "check:images": "tsx scripts/check-image-assets.ts",
    "dev": "react-router dev",
    "generate:og": "node scripts/generate-og-images.mjs",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "quality": "npm run format:check && npm run check:comments && npm run check:images && npm run validate:content && npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "i18n:validate": "tsx scripts/validate-i18n.ts",
    "translations:validate": "tsx scripts/validate-translations.ts",
    "translations:stale": "tsx scripts/mark-stale-translations.ts --check",
    "prerender:routes": "tsx scripts/generate-prerender-routes.ts",
    "sitemap:generate": "tsx scripts/generate-sitemaps.ts",
    "hreflang:check": "tsx scripts/check-hreflang.ts"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "gray-matter": "^4.0.3",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
