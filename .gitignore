# 文件职责：排除依赖、构建产物、本地环境和测试报告，避免提交机器状态。
node_modules/
build/
.react-router/
playwright-report/
test-results/
coverage/
.env
.env.local
*.log
.DS_Store

# 构建期生成的按 slug OG 分享图（由 scripts/generate-og-images.mjs 产出，不纳入源码）
app/assets/images/og/

# 项目级智能体工作记忆（本地数据，非源码）
.workbuddy/

# 工具缓存与锁文件（非源码，机器/会话产物）
.agents/
skills-lock.json

# 搜索引擎后台分析导出（含查询性能数据，非源码）
stratlore-search-console-*-queries.csv
stratlore-search-console-*.csv

# 临时脚本与生成物（以下划线或 tmp 前缀标识，非源码）
scripts/_*
scripts/tmp_*

